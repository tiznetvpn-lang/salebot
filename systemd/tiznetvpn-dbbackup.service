[Unit]
Description=Create a local SQLite snapshot for TiznetVPN
After=tiznetvpn.service
RequiresMountsFor=/var/lib/tiznetvpn /var/backups/tiznetvpn

[Service]
Type=oneshot
User=tiznetvpn
Group=tiznetvpn
WorkingDirectory=/opt/tiznetvpn
EnvironmentFile=/etc/tiznetvpn/tiznetvpn.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/tiznetvpn
Environment=DB_BACKUP_DIR=/var/backups/tiznetvpn
ExecStart=/usr/bin/node /opt/tiznetvpn/scripts/backup-sqlite.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/tiznetvpn /var/backups/tiznetvpn
