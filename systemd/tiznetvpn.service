[Unit]
Description=TiznetVPN Telegram Shop (Node.js + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tiznetvpn
Group=tiznetvpn
WorkingDirectory=/opt/tiznetvpn
EnvironmentFile=/etc/tiznetvpn/tiznetvpn.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/tiznetvpn
Environment=DB_BACKUP_DIR=/var/backups/tiznetvpn
ExecStart=/usr/bin/node /opt/tiznetvpn/server/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/tiznetvpn

[Install]
WantedBy=multi-user.target
