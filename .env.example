# فایل را به /etc/tiznetvpn/tiznetvpn.env کپی کنید و مقادیر واقعی را فقط روی سرور وارد کنید.
# این فایل نمونه را با توکن یا رمز واقعی در مخزن/چت منتشر نکنید.

# توکن ربات BotFather
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE

# رشته تصادفی 64 رقمی hex بسازید: openssl rand -hex 32
WEBHOOK_SECRET=PASTE_64_HEX_RANDOM_CHARACTERS_HERE

# شناسه عددی تلگرام ادمین‌ها، با کاما جدا شود
ADMIN_IDS=123456789

# دامنه باید HTTPS باشد و به ریشه پروژه اشاره کند؛ مسیر نگذارید
PUBLIC_BASE_URL=https://bot.tiznet.site
# در حالت معمول از PUBLIC_BASE_URL + /miniapp ساخته می‌شود؛ مقدار سفارشی اختیاری:
MINIAPP_URL=https://bot.tiznet.site/miniapp

# مسیر سرور و دیتابیس (در systemd به /var/lib/tiznetvpn تنظیم می‌شود)
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/tiznetvpn
MAX_REQUEST_BYTES=57671680

# مقدار پیش‌فرض: true؛ فقط اگر ربات کلاسیک قدیمی را می‌خواهید false کنید
MINIAPP_ONLY_MODE=true

# اختیاری: برای پرداخت خودکار Shetab؛ اگر خالی باشد پرداخت خودکار غیرفعال می‌ماند
SHETAB_API_SECRET=

# اختیاری: توکن ربات دوم برای ارسال بکاپ به مدیر به‌جای ربات اصلی.
# اگر خالی بماند، می‌توانید همان توکن را از مینی‌اپ ← تنظیمات ← پشتیبان ثبت کنید.
# توجه: بات دوم را در تلگرام باز کنید و Start بزنید، وگرنه تلگرام اجازهٔ ارسال فایل به شما را نمی‌دهد.
BACKUP_BOT_TOKEN=

# بکاپ محلی SQLite: مقصد و تعداد روزهای نگه‌داری
DB_BACKUP_DIR=/var/backups/tiznetvpn
DB_BACKUP_RETENTION_DAYS=14
